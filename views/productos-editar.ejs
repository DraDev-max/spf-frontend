<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Producto - Sport Family</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
    <script src="/theme.js" defer></script>
</head>
<body class="form-page">
    <header class="dashboard-header">
        <div class="dashboard-header-inner">
            <div class="brand">
                <img src="/img/logo-sf.png" alt="Sport Family Zapatos" class="brand-mark">
                <div class="brand-copy">
                    <span>Sport Family</span>
                    <small>Zapatos</small>
                </div>
            </div>

            <div class="top-actions">
                <div class="user-pill">Usuario: <%= usuario %> Â· <%= rol || 'cliente' %></div>
                <a href="/admin/productos" class="btn btn-ghost">Volver</a>
                <a href="/usuarios" class="btn btn-ghost">Usuarios</a>
                <a href="/menu" class="btn btn-danger">Salir</a>
            </div>
        </div>
    </header>

    <main class="dashboard-wrap">
        <section class="hero-card">
            <div class="meta-chip">Editar</div>
            <h1 class="hero-title">Editar producto</h1>
            <p class="hero-copy">Ajusta imagen, categoría, stock, precio y imagen.</p>
        </section>

        <section class="section-card form-card">
            <% if (error) { %>
                <div class="error"><%= error %></div>
            <% } %>

            <form action="/admin/productos/editar" method="POST" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="id" value="<%= producto.id %>">

                <div class="form-group">
                    <label for="categoria_id">Categoría</label>
                    <select id="categoria_id" name="categoria_id" required>
                        <option value="">Select a category</option>
                        <% categorias.forEach((categoria) => { %>
                            <option value="<%= categoria.id %>" <%= String(producto.categoria_id) === String(categoria.id) ? 'selected' : '' %>><%= categoria.nombre %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="form-group">
                    <label for="nombre">Nombre</label>
                    <input type="text" id="nombre" name="nombre" value="<%= producto.nombre %>" required>
                </div>

                <div class="form-group">
                    <label for="descripcion">Descripción</label>
                    <textarea id="descripcion" name="descripcion" rows="4"><%= producto.descripcion %></textarea>
                </div>

                <div class="form-group">
                    <label for="marca">Marca</label>
                    <input type="text" id="marca" name="marca" value="<%= producto.marca %>">
                </div>

                <div class="form-group">
                    <label for="sku">SKU</label>
                    <input type="text" id="sku" name="sku" value="<%= producto.sku %>">
                </div>

                <div class="form-group">
                    <label for="size">Talla / Variante</label>
                    <input type="text" id="size" name="size" value="<%= producto.size || 'U' %>">
                </div>

                <div class="form-group">
                    <label for="color">Color</label>
                    <input type="text" id="color" name="color" value="<%= producto.color || 'predeterminado' %>">
                </div>

                <div class="form-group">
                    <label for="precio">Precio</label>
                    <input type="number" id="precio" name="precio" value="<%= producto.precio %>" min="0" step="0.01" required>
                </div>
                <div class="form-group">
                    <label for="descuento_porcentaje">Descuento %</label>
                    <input type="number" id="descuento_porcentaje" name="descuento_porcentaje" value="<%= producto.descuento_porcentaje || 0 %>" min="0" max="100" step="0.01">
                    <small>Solo se permiten valores de 0% a 100%.</small>
                </div>


<div class="form-group">
                    <label for="stock">Stock actual</label>
                    <input type="number" id="stock" name="stock" value="<%= producto.stock %>" min="0" step="1" required>
                </div>

                <div class="form-group">
                    <label for="low_stock_threshold">Umbral de stock bajo</label>
                    <input type="number" id="low_stock_threshold" name="low_stock_threshold" value="<%= producto.low_stock_threshold || 5 %>" min="0" step="1">
                </div>

                <div class="form-group">
                    <label for="warehouse_location">Ubicación en almacén</label>
                    <input type="text" id="warehouse_location" name="warehouse_location" value="<%= producto.warehouse_location || '' %>" placeholder="Almacén principal">
                </div>

                <div class="form-group">
                    <label for="stock_adjustment">Recepción / ajuste de stock</label>
                    <input type="number" id="stock_adjustment" name="stock_adjustment" value="0" min="0" step="1">
                    <small>Solo números positivos; para bajar stock edita el stock actual.</small>
                </div>

                <div class="form-group">
                    <label for="imagen_url">URL de imagen</label>
                    <input type="url" id="imagen_url" name="imagen_url" value="<%= producto.imagen_url %>" placeholder="https://...">
                </div>

                <div class="form-group">
                    <label for="activo">Estado</label>
                    <select id="activo" name="activo">
                        <option value="1" <%= Number(producto.activo) ? 'selected' : '' %>>Activo</option>
                        <option value="0" <%= Number(producto.activo) ? '' : 'selected' %>>Inactivo</option>
                    </select>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Actualizar</button>
                    <a href="/admin/productos" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </section>
    </main>
</body>
</html>

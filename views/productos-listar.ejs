<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Productos - Sport Family</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
    <script src="/theme.js" defer></script>
</head>
<body class="list-page">
    <header class="dashboard-header">
        <div class="dashboard-header-inner">
            <div class="brand">
                <img src="/img/logo-sf.png" alt="Sport Family Zapatos" class="brand-mark">
                <div class="brand-copy">
                    <span>Sport Family</span>
                    <small>Zapatos</small>
                </div>
            </div>

            <div class="top-actions">
                <div class="user-pill">Usuario: <%= usuario %> · <%= rol || 'cliente' %></div>
                <a href="/menu" class="btn btn-ghost">Menú</a>
                <a href="/usuarios" class="btn btn-ghost">Usuarios</a>
                <a href="/admin/productos/nuevo" class="btn btn-primary">+ Nuevo producto</a>
                <a href="/menu" class="btn btn-danger">Salir</a>
            </div>
        </div>
    </header>

    <main class="dashboard-wrap">
        <section class="hero-card">
            <div class="meta-chip"><%= productos.length %> registros</div>
            <h1 class="hero-title">Lista de productos</h1>
            <p class="hero-copy">Administra el Inventario</p>
        </section>


        <section class="section-card">
            <h2 class="section-title">Carga masiva CSV</h2>
            <p class="section-subtitle">Columnas: name,description,brand,sku,price,stock,category_id,size,color,low_stock_threshold,warehouse_location,image_url</p>
            <form action="/admin/productos/importar" method="POST" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group" style="grid-column:1/-1;">
                    <textarea name="csv" rows="5" placeholder="name,description,brand,sku,price,stock,category_id\nAir,Literal air,QA,AIR-001,1,300000000,1"></textarea>
                </div>
                <div class="form-actions"><button class="btn btn-primary" type="submit">Importar CSV</button></div>
            </form>
        </section>

        <section class="section-card">
            <div class="section-header">
                <div>
                    <h2 class="section-title">Productos registrados</h2>
                    <p class="section-subtitle">Controla precio, stock, categoría e imagen de cada producto.</p>
                </div>
            </div>

            <% if (productos.length === 0) { %>
                <div class="empty-state">
                    <p>No hay productos registrados.</p>
                    <div style="margin-top: 14px;">
                        <a href="/admin/productos/nuevo" class="btn btn-primary">Crear producto</a>
                    </div>
                </div>
            <% } else { %>
                <div class="table-shell">
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Categoría</th>
                                <th>Marca</th>
                                <th>SKU</th>
                                <th>Variante</th>
                                <th>Precio</th>
                                <th>Descuento</th>
                                <th>Final</th>
                                <th>Existencias</th>
                                <th>Almacén</th>
                                <th>Imagen</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% productos.forEach((producto) => { %>
                                <tr>
                                    <td><%= producto.id %></td>
                                    <td><%= producto.nombre %></td>
                                    <td><%= producto.categoria_nombre || 'Sin categoría' %></td>
                                    <td><%= producto.marca || '-' %></td>
                                    <td><%= producto.sku || '-' %></td>
                                    <td><%= producto.size || 'U' %> / <%= producto.color || 'predeterminado' %></td>
                                    <td>$<%= Number(producto.precio || 0).toFixed(2) %></td>
                                    <td><%= Number(producto.descuento_final_porcentaje ?? producto.descuento_porcentaje ?? 0).toFixed(2) %>%</td>
                                    <td>$<%= Number(producto.precio_final ?? producto.precio ?? 0).toFixed(2) %></td>
                                    <td><%= producto.stock %> <% if (producto.stock_bajo) { %><span class="meta-chip" style="background:#fff3cd;color:#8a5a00;">Stock bajo</span><% } %></td>
                                    <td><%= producto.warehouse_location || '-' %><br><small>Min: <%= producto.low_stock_threshold || 5 %></small></td>
                                    <td>
                                        <% if (producto.imagen_url) { %>
                                            <img src="<%= producto.imagen_url %>" alt="<%= producto.nombre %>" style="width:52px;height:52px;object-fit:cover;border-radius:12px;border:1px solid #e5e7eb;background:#f8fafc;">
                                        <% } else { %>
                                            <span class="meta-chip">Sin imagen</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (producto.activo) { %>
                                            <span class="meta-chip">Activo</span>
                                        <% } else { %>
                                            <span class="meta-chip" style="background:#ffe5e5;color:#c92a2a;">Inactivo</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div class="actions">
                                            <a href="/admin/productos/editar/<%= producto.id %>" class="btn btn-primary">Editar</a>
                                            <form action="/admin/productos/eliminar" method="POST">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="id" value="<%= producto.id %>">
                                                <button type="submit" class="btn btn-danger" onclick="return confirm('¿Eliminar este producto?')">Eliminar</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>
    </main>
</body>
</html>

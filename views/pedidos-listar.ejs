<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pedidos - Sport Family</title>
    <link rel="stylesheet" href="/styles.css">
    <script src="/theme.js" defer></script>
</head>
<body class="list-page">
    <header class="dashboard-header">
        <div class="dashboard-header-inner">
            <div class="brand">
                <img src="/img/logo-sf.png" alt="Sport Family Zapatos" class="brand-mark">
                <div class="brand-copy">
                    <span>Sport Family</span>
                    <small>Zapatos</small>
                </div>
            </div>
            <div class="top-actions">
                <div class="user-pill">Usuario: <%= usuario %> · <%= rol || 'admin' %></div>
                <a href="/menu" class="btn btn-ghost">Menú</a>
                <% if (adminView) { %>
                    <a href="/admin/productos" class="btn btn-ghost">Inventario</a>
                <% } %>
                <a href="/menu" class="btn btn-danger">Salir</a>
            </div>
        </div>
    </header>

    <main class="dashboard-wrap">
        <section class="hero-card">
            <div class="meta-chip"><%= pedidos.length %> pedidos</div>
            <h1 class="hero-title"><%= titulo || 'Pedidos' %></h1>
            <p class="hero-copy"><%= descripcion || 'Órdenes creadas desde el carrito.' %></p>
        </section>

        <section class="section-card">
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="error"><%= error %></div>
            <% } %>


            <% if (adminView) { %>
                <form method="GET" action="/admin/pedidos" class="form-grid" style="margin-bottom:18px;">
                    <div class="form-group"><label>Buscar</label><input name="q" value="<%= query?.q || '' %>" placeholder="correo, nombre o número de pedido"></div>
                    <div class="form-group"><label>Estado</label><select name="estado"><option value="">Todos</option><% ['pendiente','pagado','enviado','entregado','cancelado'].forEach((e)=>{ %><option value="<%= e %>" <%= query?.estado===e?'selected':'' %>><%= e %></option><% }) %></select></div>
                    <div class="form-group"><label>Date</label><input type="date" name="fecha" value="<%= query?.fecha || '' %>"></div>
                    <div class="form-actions"><button class="btn btn-primary" type="submit">Filtrar</button></div>
                </form>
            <% } %>

            <% if (pedidos.length === 0) { %>
                <div class="empty-state">No hay pedidos registrados.</div>
            <% } else { %>
                <div class="orders-list">
                    <% pedidos.forEach((pedido) => { %>
                        <article class="order-card">
                            <div class="order-card-header">
                                <div><strong>Pedido #<%= pedido.numero_pedido %></strong><small><%= pedido.cliente_nombre || pedido.cliente_email || pedido.session_id || 'Sin cliente' %></small></div>
                                <span class="meta-chip"><%= pedido.estado %></span>
                            </div>
                            <div class="order-items">
                                <% (pedido.detalle || []).forEach((item) => { %>
                                    <div><span><%= item.nombre || item.producto_nombre || ('Producto ' + item.producto_id) %></span><strong>× <%= item.cantidad %></strong></div>
                                <% }) %>
                            </div>
                            <div class="order-card-footer">
                                <span><%= pedido.cupon_codigo ? 'Cupón: ' + pedido.cupon_codigo : 'Sin cupón' %></span>
                                <strong>$<%= Number(pedido.total || 0).toFixed(2) %></strong>
                            </div>
                            <% if (adminView) { %>
                                <form action="/admin/pedidos/estado" method="POST" class="order-update">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="id" value="<%= pedido.id %>">
                                    <select name="estado"><% ['pendiente','pagado','enviado','entregado','cancelado'].forEach((e)=>{ %><option value="<%= e %>" <%= pedido.estado===e?'selected':'' %>><%= e %></option><% }) %></select>
                                    <button class="btn btn-primary" type="submit">Guardar estado</button>
                                </form>
                            <% } %>
                        </article>
                    <% }) %>
                </div>
            <% } %>
        </section>
    </main>
</body>
</html>
